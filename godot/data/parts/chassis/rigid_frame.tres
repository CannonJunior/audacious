[resource]
script = ExtResource("1_spr")
part_id = &"rigid_frame"
display_name = "Rigid Frame"
description = "Single-shell monocoque — the shell is the structure. Maximum stiffness means thruster and actuator energy transfers with almost no loss. The chassis that wants to go in one direction at high velocity and not be asked to do anything else. Stiffness transmits vibration and heat without damping either."
slot = 0
systems_load = 0.0
systems_capacity = 1.00
thrust_factor = 1.0
actuator_factor = 1.0
thermal_coefficient = 1.90
armor_points = 0.0
damage_bonus = 0.0
mesh_surface_indices = PackedInt32Array()
origin_faction = 0
