[ext_resource type="Script" path="res://data/SuitPartResource.gd" id="1_spr"]

[resource]
script = ExtResource("1_spr")
part_id = &"slim_frame"
display_name = "Slim Frame"
description = "Reduced cross-section geometry. Physically narrower than any other chassis — and that is the point. There are spaces in this city that a standard suit cannot enter: HVAC shafts, maintenance conduits, the gaps between structural columns. The Slim Frame was designed around those dimensions. Fewer attachment points because the geometry is smaller."
slot = 0
systems_load = 0.0
systems_capacity = 0.78
thrust_factor = 1.0
actuator_factor = 1.0
thermal_coefficient = 0.55
armor_points = 0.0
damage_bonus = 0.0
mesh_surface_indices = PackedInt32Array()
origin_faction = 0
